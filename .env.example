# Supabase Database Configuration
# (Can also be configured directly via the in-app Onboarding flow)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Software Licensing & Device Activation Authority
# Production backend API URL (e.g. https://licensing.yourdomain.com)
VITE_LICENSE_API_URL=https://licensing.plywood-erp.com

# Enable mock licensing ONLY during local development (strictly ignored in production builds)
VITE_LICENSE_MOCK=false
